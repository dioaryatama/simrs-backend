NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=simrs_v2
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT
JWT_SECRET=simrs_super_secret_key_change_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=simrs_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# App
APP_NAME=SIMRS v2 API
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# BPJS VClaim
BPJS_CONS_ID=
BPJS_SECRET_KEY=
BPJS_USER_KEY=
BPJS_BASE_URL=https://apijkn-dev.bpjs-kesehatan.go.id/vclaim-rest-dev

# Notification
SMS_PROVIDER=
WA_API_URL=
WA_API_KEY=
