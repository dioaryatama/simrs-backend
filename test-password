-- ── Tarif efektif hari ini (tanpa subquery berulang) ─────────────
CREATE VIEW v_active_tariffs AS
SELECT
    st.id             AS tariff_id,
    s.id              AS service_id,
    s.code            AS service_code,
    s.name            AS service_name,
    s.service_type,
    ps.code           AS scheme_code,
    ps.name           AS scheme_name,
    ps.scheme_type,
    st.room_class,
    st.tariff_class,
    st.base_price,
    st.doctor_fee,
    st.hospital_fee,
    st.includes_tax,
    st.tax_rate,
    CASE
        WHEN st.includes_tax THEN st.base_price
        ELSE st.base_price * (1 + st.tax_rate / 100)
    END               AS total_with_tax,
    st.effective_date,
    st.expired_date
FROM service_tariffs st
JOIN services        s  ON s.id  = st.service_id
JOIN payment_schemes ps ON ps.id = st.payment_scheme_id
WHERE st.is_active = true
  AND st.effective_date <= CURRENT_DATE
  AND (st.expired_date IS NULL OR st.expired_date >= CURRENT_DATE)
  AND s.is_active = true;

-- ── Jadwal dokter aktif minggu ini ───────────────────────────────
CREATE VIEW v_doctor_weekly_schedule AS
SELECT
    ds.id              AS schedule_id,
    d.id               AS doctor_id,
    e.full_name        AS doctor_name,
    CONCAT(d.title_prefix, ' ', e.full_name, ', ', d.title_suffix) AS doctor_full_title,
    c.id               AS clinic_id,
    c.name             AS clinic_name,
    c.code             AS clinic_code,
    ds.day_of_week,
    CASE ds.day_of_week
        WHEN 0 THEN 'Minggu'
        WHEN 1 THEN 'Senin'
        WHEN 2 THEN 'Selasa'
        WHEN 3 THEN 'Rabu'
        WHEN 4 THEN 'Kamis'
        WHEN 5 THEN 'Jumat'
        WHEN 6 THEN 'Sabtu'
    END                AS day_name,
    ds.time_start,
    ds.time_end,
    ds.quota,
    ds.slot_duration_min
FROM doctor_schedules  ds
JOIN doctors           d  ON d.id = ds.doctor_id
JOIN employees         e  ON e.id = d.employee_id
JOIN clinics           c  ON c.id = ds.clinic_id
WHERE ds.is_active = true
  AND d.is_active  = true
  AND ds.effective_from <= CURRENT_DATE
  AND (ds.effective_until IS NULL OR ds.effective_until >= CURRENT_DATE);

-- ── Layanan lengkap dengan kategori dan instalasi ─────────────────
CREATE VIEW v_services_full AS
SELECT
    s.id,
    s.code,
    s.name,
    s.name_alias,
    s.service_type,
    s.unit_of_measure,
    s.duration_minutes,
    s.requires_doctor,
    s.is_package,
    s.is_bpjs_covered,
    s.is_active,
    sc.code            AS category_code,
    sc.name            AS category_name,
    sc_parent.name     AS category_parent_name,
    i.code             AS installation_code,
    i.name             AS installation_name,
    i.installation_type
FROM services          s
JOIN service_categories sc         ON sc.id = s.category_id
LEFT JOIN service_categories sc_parent ON sc_parent.id = sc.parent_id
JOIN installations     i           ON i.id = s.installation_id;
