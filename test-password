-- ── Trigger: hitung keterlambatan otomatis saat check_in diisi ───
CREATE OR REPLACE FUNCTION fn_calc_late_minutes()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
DECLARE
    v_shift_start time;
    v_scheduled   timestamptz;
BEGIN
    IF NEW.check_in IS NOT NULL AND NEW.shift_id IS NOT NULL THEN
        SELECT start_time INTO v_shift_start
        FROM work_shifts WHERE id = NEW.shift_id;

        v_scheduled := (NEW.attendance_date + v_shift_start)::timestamptz;
        NEW.late_minutes := GREATEST(0,
            (EXTRACT(EPOCH FROM (NEW.check_in - v_scheduled)) / 60)::smallint
        );
    ELSE
        NEW.late_minutes := 0;
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_attendance_late
    BEFORE INSERT OR UPDATE OF check_in, shift_id ON attendances
    FOR EACH ROW EXECUTE FUNCTION fn_calc_late_minutes();

