    clinic_id         uuid        REFERENCES clinics(id),        -- NULL = berlaku semua poli
    payment_scheme_id uuid        REFERENCES payment_schemes(id), -- NULL = berlaku semua skema
    fee_type          fee_type    NOT NULL,
    amount            numeric(12,2) NOT NULL,
