-- ── Tarif layanan per skema pembayaran & kelas kamar ─────────────
-- Satu layanan bisa punya banyak tarif (beda skema, kelas, periode)
CREATE TABLE service_tariffs (
    id                uuid            PRIMARY KEY DEFAULT uuid_generate_v4(),
    service_id        uuid            NOT NULL REFERENCES services(id),
    payment_scheme_id uuid            NOT NULL REFERENCES payment_schemes(id),
    room_class        room_class_type,   -- NULL = berlaku untuk semua kelas
    tariff_class      tariff_class    NOT NULL DEFAULT 'standard',
    base_price        numeric(14,2)   NOT NULL DEFAULT 0,
    doctor_fee        numeric(14,2)   NOT NULL DEFAULT 0,
    hospital_fee      numeric(14,2)   NOT NULL DEFAULT 0,
    -- base_price = doctor_fee + hospital_fee + komponen lain
    includes_tax      boolean         NOT NULL DEFAULT false,
    tax_rate          numeric(5,2)    NOT NULL DEFAULT 0,    -- persen, misal 11 untuk 11%
    effective_date    date            NOT NULL,
    expired_date      date,
    currency          char(3)         NOT NULL DEFAULT 'IDR',
    is_active         boolean         NOT NULL DEFAULT true,
    approved_by       uuid,           -- uuid employee yang approve
    approved_at       timestamptz,
    notes             text,
    -- migration metadata
    migrated_from_id  varchar(24),
    created_at        timestamptz     NOT NULL DEFAULT now(),
    updated_at        timestamptz     NOT NULL DEFAULT now(),
    CONSTRAINT chk_tariff_price CHECK (base_price >= 0),
    CONSTRAINT chk_tariff_dates CHECK (expired_date IS NULL OR expired_date > effective_date)
);
-- Hanya boleh ada 1 tarif aktif per kombinasi layanan+skema+kelas+periode
CREATE UNIQUE INDEX uq_tariff_active ON service_tariffs(service_id, payment_scheme_id, room_class, effective_date)
    WHERE is_active = true;
CREATE INDEX idx_tariff_service   ON service_tariffs(service_id);
CREATE INDEX idx_tariff_scheme    ON service_tariffs(payment_scheme_id);
CREATE INDEX idx_tariff_effective ON service_tariffs(effective_date);
CREATE INDEX idx_tariff_active    ON service_tariffs(is_active) WHERE is_active = true;

-- ── Jasa dokter (bisa berbeda per dokter, poli, skema) ──────────
CREATE TABLE doctor_fees (
    id                uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
