-- ── Trigger: hitung LOS otomatis saat discharge_date diisi ───────
CREATE OR REPLACE FUNCTION fn_calc_los()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    IF NEW.discharge_date IS NOT NULL THEN
        NEW.actual_los_days := GREATEST(0,
            ((NEW.discharge_date - NEW.admission_date) / INTERVAL '1 day')::smallint
        );
    ELSE
        NEW.actual_los_days := NULL;
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_admission_los
    BEFORE INSERT OR UPDATE OF discharge_date ON admissions
    FOR EACH ROW EXECUTE FUNCTION fn_calc_los();

