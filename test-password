-- ================================================================
-- SIMRS v2 — INSTALASI LENGKAP (ALL-IN-ONE)
-- ================================================================
-- File ini menggabungkan SEMUA schema dan seeder dalam urutan
-- yang benar. Cukup jalankan FILE INI SAJA dari awal hingga akhir.
--
-- Urutan internal:
--   BAGIAN 1 — Master Data Schema  (30 tabel: organisasi, layanan)
--   BAGIAN 2 — Master Data Seeder  (wilayah, obat, jadwal, tarif)
--   BAGIAN 3 — Full Schema         (46 tabel: auth, EMR, billing)
--   BAGIAN 4 — Full Seeder         (user, kunjungan, transaksi)
--   BAGIAN 5 — Extended Schema     (29 tabel: finance, HR, aset)
--   BAGIAN 6 — Extended Seeder     (CoA, aset, jabatan, payroll)
--
-- Cara pakai:
--   psql -U postgres -d simrs_v2 -f SIMRS_v2_INSTALL_ALL.sql
--   atau copy-paste per bagian di DBeaver/TablePlus/pgAdmin
-- ================================================================

-- Aktifkan ekstensi yang dibutuhkan
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "pg_trgm";


-- ================================================================
-- BAGIAN 1 — MASTER DATA SCHEMA
-- ================================================================
-- ================================================================
-- SIMRS v2 — MASTER DATA SCHEMA (COMPLETE)
-- ================================================================
-- Cakupan   : Semua instalasi (RJ, RI, IGD, Bedah, Lab, Rad, Farmasi, Rehab)
-- Tarif      : Multi-skema (BPJS, Asuransi, Umum, Corporate)
-- Organisasi : Kompleks (Instalasi → Departemen/SMF → Poli → Sub-poli)
-- Tabel      : 28 tabel utama + 3 views + seed data
-- ================================================================
-- URUTAN EKSEKUSI:
-- 000_extensions  → Ekstensi PostgreSQL & enum types
-- 001_reference   → Wilayah, alamat, golongan obat, ICD, konfigurasi
-- 002_organization→ Ruangan, instalasi, departemen, poli
-- 003_personnel   → Pegawai, dokter, spesialisasi, pasien, penjamin, skema
-- 004_services    → Kategori layanan, layanan, paket, mapping, requirement
-- 005_tariffs     → Tarif, jasa dokter, jadwal, pengecualian jadwal, views
-- 006_seed_data   → Data referensi awal
-- 007_sample_serv → Contoh data layanan per instalasi
-- ================================================================

-- ================================================================
-- SIMRS v2 — Master Data Schema
-- PostgreSQL 15+
-- Generated for: All services, multi-scheme tariff, complex org
-- ================================================================


-- Custom types / enums
CREATE TYPE gender_type       AS ENUM ('male', 'female');
CREATE TYPE blood_type        AS ENUM ('A', 'B', 'AB', 'O', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-', 'unknown');
CREATE TYPE room_class_type   AS ENUM ('vip', 'class_1', 'class_2', 'class_3', 'icu', 'nicu', 'picu', 'isolasi', 'ok', 'igd');
CREATE TYPE service_type      AS ENUM ('consultation', 'procedure', 'surgery', 'injection', 'lab_test', 'radiology', 'pharmacy', 'rehabilitation', 'inpatient', 'emergency', 'package', 'other');
CREATE TYPE payment_scheme_type AS ENUM ('bpjs', 'insurance', 'general', 'corporate', 'free');
CREATE TYPE payer_type        AS ENUM ('bpjs', 'private_insurance', 'company', 'government', 'self');
CREATE TYPE employee_type     AS ENUM ('permanent', 'contract', 'intern', 'honorary', 'resident');
CREATE TYPE installation_type AS ENUM ('rawat_jalan', 'rawat_inap', 'igd', 'bedah', 'laboratorium', 'radiologi', 'farmasi', 'rehabilitasi', 'penunjang', 'administrasi');
CREATE TYPE clinic_type       AS ENUM ('outpatient', 'inpatient', 'igd', 'surgery', 'lab', 'radiology', 'pharmacy', 'rehab', 'sub_clinic');
CREATE TYPE region_level      AS ENUM ('province', 'city', 'district', 'village');
CREATE TYPE exception_type    AS ENUM ('cancelled', 'substituted', 'extra_schedule');
CREATE TYPE fee_type          AS ENUM ('consultation', 'procedure', 'surgery', 'visit', 'oncall');
CREATE TYPE drug_form         AS ENUM ('tablet', 'capsule', 'syrup', 'injection', 'infusion', 'cream', 'ointment', 'drops', 'inhaler', 'suppository', 'patch', 'other');
CREATE TYPE ref_type          AS ENUM ('icd10', 'icd9', 'drug');
CREATE TYPE clinical_rel_type AS ENUM ('indicated_for', 'contraindicated', 'commonly_used_drug', 'required_lab');
CREATE TYPE requirement_type  AS ENUM ('prerequisite_service', 'lab_result', 'consent_form', 'referral_letter', 'fasting', 'doctor_order');
CREATE TYPE mapping_type      AS ENUM ('ina_cbg', 'icd9_cm', 'tarif_rs_v1', 'bpjs_special', 'insurance_code');
CREATE TYPE config_value_type AS ENUM ('string', 'number', 'boolean', 'json', 'date');
CREATE TYPE tariff_class      AS ENUM ('standard', 'executive', 'emergency', 'oncall');
-- ================================================================
-- 001 — REFERENSI WILAYAH & UMUM
-- ================================================================

-- ── Wilayah (self-referencing tree: provinsi → kab/kota → kec → kel) ──
CREATE TABLE regions (
    id          uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    parent_id   uuid        REFERENCES regions(id),
    code        varchar(10) NOT NULL,
    name        varchar(100) NOT NULL,
    level       region_level NOT NULL,
    created_at  timestamptz NOT NULL DEFAULT now(),
    updated_at  timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_regions_code ON regions(code);
CREATE INDEX idx_regions_parent    ON regions(parent_id);
CREATE INDEX idx_regions_level     ON regions(level);

-- ── Alamat (dipakai oleh pasien, pegawai, penjamin) ──────────────
CREATE TABLE addresses (
    id          uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    street      text,
    rt_rw       varchar(10),
    postal_code varchar(10),
    village_id  uuid        REFERENCES regions(id),  -- level kelurahan
    latitude    numeric(9,6),
    longitude   numeric(9,6),
    created_at  timestamptz NOT NULL DEFAULT now(),
    updated_at  timestamptz NOT NULL DEFAULT now()
);
CREATE INDEX idx_addresses_village ON addresses(village_id);

-- ── Golongan obat ────────────────────────────────────────────────
CREATE TABLE drug_classes (
    id                    uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    code                  varchar(10) NOT NULL,
    name                  varchar(100) NOT NULL,
    requires_prescription boolean     NOT NULL DEFAULT true,
    storage_condition     varchar(100),
    description           text,
    is_active             boolean     NOT NULL DEFAULT true,
    created_at            timestamptz NOT NULL DEFAULT now(),
    updated_at            timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_drug_classes_code ON drug_classes(code);

-- ── Konfigurasi sistem ───────────────────────────────────────────
CREATE TABLE system_configs (
    id          uuid             PRIMARY KEY DEFAULT uuid_generate_v4(),
    key         varchar(100)     NOT NULL,
    value       text             NOT NULL,
    value_type  config_value_type NOT NULL DEFAULT 'string',
    group_name  varchar(50)      NOT NULL DEFAULT 'general',
    description text,
    is_editable boolean          NOT NULL DEFAULT true,
    updated_by  uuid,
    created_at  timestamptz      NOT NULL DEFAULT now(),
    updated_at  timestamptz      NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_system_configs_key ON system_configs(key);
CREATE INDEX idx_system_configs_group ON system_configs(group_name);

-- ── ICD-10 Diagnosa ──────────────────────────────────────────────
CREATE TABLE icd10_diagnoses (
    id          uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    code        varchar(10) NOT NULL,
    name_id     text        NOT NULL,   -- Bahasa Indonesia
    name_en     text,                   -- Bahasa Inggris
    category    varchar(3),             -- A00, B01, dst
    block       varchar(10),            -- rentang kode (A00-A09)
    is_active   boolean     NOT NULL DEFAULT true,
    created_at  timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_icd10_code ON icd10_diagnoses(code);
CREATE INDEX idx_icd10_category  ON icd10_diagnoses(category);
CREATE INDEX idx_icd10_name_trgm ON icd10_diagnoses USING gin(name_id gin_trgm_ops);

-- ── ICD-9-CM Prosedur ────────────────────────────────────────────
CREATE TABLE icd9_procedures (
    id          uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    code        varchar(10) NOT NULL,
    name_id     text        NOT NULL,
    name_en     text,
    category    varchar(5),
    is_active   boolean     NOT NULL DEFAULT true,
    created_at  timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_icd9_code ON icd9_procedures(code);
CREATE INDEX idx_icd9_name_trgm ON icd9_procedures USING gin(name_id gin_trgm_ops);

-- ── Obat / Formularium ───────────────────────────────────────────
CREATE TABLE drugs (
    id               uuid       PRIMARY KEY DEFAULT uuid_generate_v4(),
    code             varchar(20) NOT NULL,
    generic_name     varchar(200) NOT NULL,
    brand_name       varchar(200),
    drug_class_id    uuid       NOT NULL REFERENCES drug_classes(id),
    drug_form        drug_form  NOT NULL,
    strength         varchar(30),    -- misal: "500mg", "10mg/5ml"
    unit             varchar(20),    -- misal: "tablet", "ml", "vial"
    min_stock        integer    NOT NULL DEFAULT 0,
    is_formularium   boolean    NOT NULL DEFAULT true,
    is_narcotic      boolean    NOT NULL DEFAULT false,
    is_psychotropic  boolean    NOT NULL DEFAULT false,
    bpjs_code        varchar(20),    -- kode BPJS e-catalogue
    notes            text,
    is_active        boolean    NOT NULL DEFAULT true,
    created_at       timestamptz NOT NULL DEFAULT now(),
    updated_at       timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_drugs_code     ON drugs(code);
CREATE INDEX idx_drugs_class          ON drugs(drug_class_id);
CREATE INDEX idx_drugs_bpjs_code      ON drugs(bpjs_code) WHERE bpjs_code IS NOT NULL;
CREATE INDEX idx_drugs_generic_trgm   ON drugs USING gin(generic_name gin_trgm_ops);
CREATE INDEX idx_drugs_brand_trgm     ON drugs USING gin(brand_name gin_trgm_ops) WHERE brand_name IS NOT NULL;
-- ================================================================
-- 002 — ORGANISASI RUMAH SAKIT
-- ================================================================

-- ── Ruangan / Fasilitas ──────────────────────────────────────────
CREATE TABLE rooms (
    id           uuid           PRIMARY KEY DEFAULT uuid_generate_v4(),
    building     varchar(50)    NOT NULL,
    floor        smallint       NOT NULL DEFAULT 1,
    room_number  varchar(20)    NOT NULL,
    room_name    varchar(100),
    room_class   room_class_type NOT NULL,
    room_type    varchar(50),   -- 'examination', 'operating', 'recovery', 'ward', dst
    capacity     smallint       NOT NULL DEFAULT 1,
    facilities   jsonb,         -- ["AC", "TV", "Toilet", "Kamar Mandi"]
    is_active    boolean        NOT NULL DEFAULT true,
    notes        text,
    created_at   timestamptz    NOT NULL DEFAULT now(),
    updated_at   timestamptz    NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_rooms_number ON rooms(building, room_number);
CREATE INDEX idx_rooms_class        ON rooms(room_class);
CREATE INDEX idx_rooms_type         ON rooms(room_type);

-- ── Instalasi (level tertinggi: Instalasi Rawat Jalan, Instalasi Bedah, dst) ──
CREATE TABLE installations (
    id              uuid              PRIMARY KEY DEFAULT uuid_generate_v4(),
    code            varchar(10)       NOT NULL,
    name            varchar(100)      NOT NULL,
    installation_type installation_type NOT NULL,
    head_doctor_id  uuid,             -- FK ke doctors, set nanti setelah tabel dibuat
    phone_ext       varchar(10),
    location        varchar(100),     -- deskripsi lokasi gedung
    is_active       boolean           NOT NULL DEFAULT true,
    notes           text,
    created_at      timestamptz       NOT NULL DEFAULT now(),
    updated_at      timestamptz       NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_installations_code ON installations(code);
CREATE INDEX idx_installations_type       ON installations(installation_type);

-- ── Departemen / SMF (Staf Medis Fungsional) ────────────────────
CREATE TABLE departments (
    id              uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    installation_id uuid        NOT NULL REFERENCES installations(id),
    code            varchar(10) NOT NULL,
    name            varchar(100) NOT NULL,
    head_doctor_id  uuid,       -- FK ke doctors
    phone_ext       varchar(10),
    is_active       boolean     NOT NULL DEFAULT true,
    notes           text,
    created_at      timestamptz NOT NULL DEFAULT now(),
    updated_at      timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_departments_code ON departments(code);
CREATE INDEX idx_departments_installation ON departments(installation_id);

-- ── Poli / Klinik (sub-poli via self-reference) ──────────────────
CREATE TABLE clinics (
    id               uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    department_id    uuid        NOT NULL REFERENCES departments(id),
    parent_clinic_id uuid        REFERENCES clinics(id),  -- untuk sub-poli
    code             varchar(10) NOT NULL,
    name             varchar(100) NOT NULL,
    clinic_type      clinic_type NOT NULL,
    room_id          uuid        REFERENCES rooms(id),
    phone_ext        varchar(10),
    queue_prefix     varchar(5),  -- prefix antrian: 'A', 'B', 'IGD', dst
    max_daily_quota  smallint,
    is_bpjs_active   boolean     NOT NULL DEFAULT false,
    is_active        boolean     NOT NULL DEFAULT true,
    notes            text,
    created_at       timestamptz NOT NULL DEFAULT now(),
    updated_at       timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_clinics_code     ON clinics(code);
CREATE INDEX idx_clinics_department     ON clinics(department_id);
CREATE INDEX idx_clinics_parent         ON clinics(parent_clinic_id) WHERE parent_clinic_id IS NOT NULL;
CREATE INDEX idx_clinics_type           ON clinics(clinic_type);
-- ================================================================
-- 003 — SDM: PEGAWAI, DOKTER, PASIEN
-- ================================================================

-- ── Spesialisasi dokter ──────────────────────────────────────────
CREATE TABLE specializations (
    id           uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    code         varchar(10) NOT NULL,
    name         varchar(100) NOT NULL,
    name_alias   varchar(100),
    icd_category varchar(10),  -- kategori ICD yang relevan
    is_active    boolean      NOT NULL DEFAULT true,
    created_at   timestamptz  NOT NULL DEFAULT now(),
    updated_at   timestamptz  NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_specializations_code ON specializations(code);

-- ── Pegawai (parent dari dokter, perawat, admin, dll) ───────────
CREATE TABLE employees (
    id              uuid          PRIMARY KEY DEFAULT uuid_generate_v4(),
    employee_number varchar(20)   NOT NULL,
    nik             varchar(16),
    full_name       varchar(150)  NOT NULL,
    date_of_birth   date,
    gender          gender_type,
    blood_type      blood_type,
    phone           varchar(20),
    email           varchar(100),
    address_id      uuid          REFERENCES addresses(id),
    employee_type   employee_type NOT NULL DEFAULT 'permanent',
    join_date       date,
    end_date        date,
    photo_url       varchar(500),
    is_active       boolean       NOT NULL DEFAULT true,
    -- migration metadata
    migrated_from_id varchar(24),
    migration_status varchar(20)  DEFAULT 'complete',
    created_at       timestamptz  NOT NULL DEFAULT now(),
    updated_at       timestamptz  NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_employees_number ON employees(employee_number);
CREATE UNIQUE INDEX uq_employees_nik    ON employees(nik) WHERE nik IS NOT NULL;
CREATE INDEX idx_employees_name_trgm    ON employees USING gin(full_name gin_trgm_ops);
CREATE INDEX idx_employees_active       ON employees(is_active);

-- ── Dokter ───────────────────────────────────────────────────────
CREATE TABLE doctors (
    id               uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    employee_id      uuid        NOT NULL UNIQUE REFERENCES employees(id),
    license_number   varchar(50),     -- nomor STR
    sip_number       varchar(50),     -- nomor SIP
    sip_expires_at   date,
    title_prefix     varchar(30),     -- "dr.", "drg.", "Dr."
    title_suffix     varchar(80),     -- "Sp.JP", "Sp.OG(K)", "M.Kes"
    signature_url    varchar(500),
    is_active        boolean     NOT NULL DEFAULT true,
    -- migration metadata
    migrated_from_id varchar(24),
    created_at       timestamptz NOT NULL DEFAULT now(),
    updated_at       timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_doctors_license ON doctors(license_number) WHERE license_number IS NOT NULL;
CREATE INDEX idx_doctors_employee      ON doctors(employee_id);
CREATE INDEX idx_doctors_active        ON doctors(is_active);

-- ── Relasi dokter ↔ spesialisasi ↔ departemen ───────────────────
CREATE TABLE doctor_specializations (
    id                uuid    PRIMARY KEY DEFAULT uuid_generate_v4(),
    doctor_id         uuid    NOT NULL REFERENCES doctors(id),
    specialization_id uuid    NOT NULL REFERENCES specializations(id),
    department_id     uuid    REFERENCES departments(id),
    is_primary        boolean NOT NULL DEFAULT false,
    certified_at      date,
    created_at        timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_doctor_spec ON doctor_specializations(doctor_id, specialization_id);
CREATE INDEX idx_doctor_spec_doctor ON doctor_specializations(doctor_id);
CREATE INDEX idx_doctor_spec_spec   ON doctor_specializations(specialization_id);

-- ── Pasien ───────────────────────────────────────────────────────
CREATE TABLE patients (
    id                uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    medical_record_no varchar(20) NOT NULL,
    nik               varchar(16),
    bpjs_number       varchar(20),
    full_name         varchar(150) NOT NULL,
    date_of_birth     date,
    gender            gender_type,
    blood_type        blood_type  DEFAULT 'unknown',
    religion          varchar(30),
    marital_status    varchar(20),
    occupation        varchar(100),
    phone             varchar(20),
    email             varchar(100),
    address_id        uuid        REFERENCES addresses(id),
    emergency_contact_name  varchar(100),
    emergency_contact_phone varchar(20),
    emergency_contact_rel   varchar(30),
    allergy_notes     text,
    notes             text,
    is_active         boolean     NOT NULL DEFAULT true,
    -- migration metadata
    migrated_from_id  varchar(24),
    migration_status  varchar(20) DEFAULT 'complete',
    data_completeness smallint    DEFAULT 100,
    missing_fields    jsonb,
    created_at        timestamptz NOT NULL DEFAULT now(),
    updated_at        timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_patients_mr_no    ON patients(medical_record_no);
CREATE UNIQUE INDEX uq_patients_nik      ON patients(nik) WHERE nik IS NOT NULL;
CREATE INDEX idx_patients_bpjs           ON patients(bpjs_number) WHERE bpjs_number IS NOT NULL;
CREATE INDEX idx_patients_name_trgm      ON patients USING gin(full_name gin_trgm_ops);
CREATE INDEX idx_patients_dob            ON patients(date_of_birth);

-- ── Penjamin / Asuransi pasien ───────────────────────────────────
CREATE TABLE payers (
    id               uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    code             varchar(20) NOT NULL,
    name             varchar(150) NOT NULL,
    payer_type       payer_type  NOT NULL,
    contract_number  varchar(50),
    contract_start   date,
    contract_end     date,
    contact_person   varchar(100),
    contact_phone    varchar(20),
    contact_email    varchar(100),
    claim_address    text,
    claim_limit      numeric(14,2),   -- batas klaim per periode
    grace_days       smallint DEFAULT 30,  -- toleransi keterlambatan klaim
    is_active        boolean     NOT NULL DEFAULT true,
    notes            text,
    created_at       timestamptz NOT NULL DEFAULT now(),
    updated_at       timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_payers_code ON payers(code);
CREATE INDEX idx_payers_type       ON payers(payer_type);
CREATE INDEX idx_payers_active     ON payers(is_active);

-- ── Skema pembayaran ─────────────────────────────────────────────
CREATE TABLE payment_schemes (
    id             uuid                 PRIMARY KEY DEFAULT uuid_generate_v4(),
    payer_id       uuid                 REFERENCES payers(id),
    code           varchar(20)          NOT NULL,
    name           varchar(100)         NOT NULL,
    scheme_type    payment_scheme_type  NOT NULL,
    tariff_class   tariff_class         NOT NULL DEFAULT 'standard',
    coverage_pct   numeric(5,2)         DEFAULT 100.00,  -- % yang ditanggung
    max_coverage   numeric(14,2),       -- plafon maksimal
    requires_rujukan boolean            NOT NULL DEFAULT false,
    is_active      boolean              NOT NULL DEFAULT true,
    notes          text,
    created_at     timestamptz          NOT NULL DEFAULT now(),
    updated_at     timestamptz          NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_payment_schemes_code ON payment_schemes(code);
CREATE INDEX idx_payment_schemes_type       ON payment_schemes(scheme_type);
CREATE INDEX idx_payment_schemes_payer      ON payment_schemes(payer_id) WHERE payer_id IS NOT NULL;
-- ================================================================
-- 004 — KATALOG LAYANAN (inti dari master data ini)
-- ================================================================

-- ── Kategori layanan (tree hirarki, max 3 level) ─────────────────
CREATE TABLE service_categories (
    id          uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    parent_id   uuid        REFERENCES service_categories(id),
    code        varchar(10) NOT NULL,
    name        varchar(100) NOT NULL,
    level       smallint    NOT NULL DEFAULT 1 CHECK (level BETWEEN 1 AND 3),
    sort_order  smallint    NOT NULL DEFAULT 0,
    is_active   boolean     NOT NULL DEFAULT true,
    created_at  timestamptz NOT NULL DEFAULT now(),
    updated_at  timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT chk_category_root CHECK (
        (level = 1 AND parent_id IS NULL) OR
        (level > 1 AND parent_id IS NOT NULL)
    )
);
CREATE UNIQUE INDEX uq_service_categories_code ON service_categories(code);
CREATE INDEX idx_svc_cat_parent                ON service_categories(parent_id) WHERE parent_id IS NOT NULL;
CREATE INDEX idx_svc_cat_level                 ON service_categories(level);

-- ── SERVICES — tabel utama ───────────────────────────────────────
CREATE TABLE services (
    id               uuid         PRIMARY KEY DEFAULT uuid_generate_v4(),
    category_id      uuid         NOT NULL REFERENCES service_categories(id),
    installation_id  uuid         NOT NULL REFERENCES installations(id),
    code             varchar(20)  NOT NULL,
    name             varchar(200) NOT NULL,
    name_alias       varchar(200),        -- nama singkat / alias untuk display
    service_type     service_type NOT NULL,
    unit_of_measure  varchar(20)  NOT NULL DEFAULT 'item',  -- 'item', 'hari', 'jam', 'pemeriksaan'
    duration_minutes smallint,            -- estimasi durasi layanan
    requires_doctor  boolean      NOT NULL DEFAULT true,
    requires_consent boolean      NOT NULL DEFAULT false,
    requires_lab_prep boolean     NOT NULL DEFAULT false,   -- butuh persiapan lab (puasa, dll)
    is_package       boolean      NOT NULL DEFAULT false,
    is_billable      boolean      NOT NULL DEFAULT true,
    is_bpjs_covered  boolean      NOT NULL DEFAULT false,
    bpjs_require_rujukan boolean  NOT NULL DEFAULT true,
    is_active        boolean      NOT NULL DEFAULT true,
    sort_order       smallint     NOT NULL DEFAULT 0,
    notes            text,
    -- migration metadata
    migrated_from_id varchar(24),
    migration_status varchar(20)  DEFAULT 'complete',
    created_at       timestamptz  NOT NULL DEFAULT now(),
    updated_at       timestamptz  NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_services_code       ON services(code);
CREATE INDEX idx_services_category         ON services(category_id);
CREATE INDEX idx_services_installation     ON services(installation_id);
CREATE INDEX idx_services_type             ON services(service_type);
CREATE INDEX idx_services_active           ON services(is_active);
CREATE INDEX idx_services_bpjs             ON services(is_bpjs_covered) WHERE is_bpjs_covered = true;
CREATE INDEX idx_services_name_trgm        ON services USING gin(name gin_trgm_ops);
CREATE INDEX idx_services_alias_trgm       ON services USING gin(name_alias gin_trgm_ops) WHERE name_alias IS NOT NULL;

-- ── Paket layanan (komponen dari services yang is_package=true) ──
CREATE TABLE service_packages (
    id                   uuid           PRIMARY KEY DEFAULT uuid_generate_v4(),
    package_service_id   uuid           NOT NULL REFERENCES services(id),
    component_service_id uuid           NOT NULL REFERENCES services(id),
    quantity             numeric(8,2)   NOT NULL DEFAULT 1,
    is_optional          boolean        NOT NULL DEFAULT false,
    sort_order           smallint       NOT NULL DEFAULT 0,
    notes                text,
    created_at           timestamptz    NOT NULL DEFAULT now(),
    CONSTRAINT chk_no_self_package CHECK (package_service_id != component_service_id)
);
CREATE UNIQUE INDEX uq_service_package_component ON service_packages(package_service_id, component_service_id);
CREATE INDEX idx_svc_pkg_package   ON service_packages(package_service_id);
CREATE INDEX idx_svc_pkg_component ON service_packages(component_service_id);

-- ── Mapping layanan ke kode eksternal (INA-CBG, ICD-9, dll) ─────
CREATE TABLE service_mappings (
    id             uuid         PRIMARY KEY DEFAULT uuid_generate_v4(),
