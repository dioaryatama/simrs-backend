CREATE INDEX idx_appt_status          ON appointments(status);

-- ── Trigger: hitung BMI otomatis saat insert/update vital signs ──
CREATE OR REPLACE FUNCTION fn_calc_bmi()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
    IF NEW.weight_kg IS NOT NULL AND NEW.height_cm IS NOT NULL AND NEW.height_cm > 0 THEN
        NEW.bmi := ROUND(
            (NEW.weight_kg / POWER(NEW.height_cm / 100.0, 2))::numeric, 2
        );
    ELSE
        NEW.bmi := NULL;
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_vitals_bmi
    BEFORE INSERT OR UPDATE OF weight_kg, height_cm ON visit_vitals
    FOR EACH ROW EXECUTE FUNCTION fn_calc_bmi();

