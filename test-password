-- BAGIAN 5 — EXTENDED SCHEMA (Finance, Inventory, HR, Payroll)
-- ================================================================
-- ================================================================
-- SIMRS v2 — EXTENDED SCHEMA (Finance + Inventory + HR)
-- Versi  : 1.0.2
-- Fixes  : Hapus semua GENERATED ALWAYS AS konflik
--          outstanding    → trigger fn_ar_aging_calc()
--          book_value     → trigger fn_asset_book_value()
--          late_minutes   → trigger fn_calc_late_minutes()
-- Urutan : Jalankan SETELAH SIMRS_v2_FULL_Schema.sql
-- ================================================================

-- ===== 08_finance.sql =====
-- ================================================================
-- 08 — FINANCE: AKUNTANSI & JURNAL OTOMATIS
-- ================================================================

-- ── Tahun fiskal ─────────────────────────────────────────────────
CREATE TABLE fiscal_years (
    id              uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    code            varchar(10) NOT NULL,
    name            varchar(50) NOT NULL,
    start_date      date        NOT NULL,
    end_date        date        NOT NULL,
    status          varchar(20) NOT NULL DEFAULT 'active',
    -- 'active','closed','locked'
    closed_by       uuid        REFERENCES users(id),
    closed_at       timestamptz,
    created_at      timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT chk_fy_dates CHECK (end_date > start_date)
);
CREATE UNIQUE INDEX uq_fiscal_year_code ON fiscal_years(code);

-- ── Periode akuntansi (bulanan) ──────────────────────────────────
CREATE TABLE accounting_periods (
    id              uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    fiscal_year_id  uuid        NOT NULL REFERENCES fiscal_years(id),
    period_number   smallint    NOT NULL CHECK (period_number BETWEEN 1 AND 12),
    name            varchar(30) NOT NULL,
    start_date      date        NOT NULL,
    end_date        date        NOT NULL,
    status          varchar(20) NOT NULL DEFAULT 'open',
    -- 'open','closed','locked'
    closed_by       uuid        REFERENCES users(id),
    closed_at       timestamptz
);
CREATE UNIQUE INDEX uq_acc_period ON accounting_periods(fiscal_year_id, period_number);
CREATE INDEX idx_period_date ON accounting_periods(start_date, end_date);

-- ── Chart of Accounts (CoA) ──────────────────────────────────────
CREATE TABLE accounts (
    id              uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    parent_id       uuid        REFERENCES accounts(id),
    code            varchar(20) NOT NULL,
    name            varchar(150) NOT NULL,
    account_type    varchar(20) NOT NULL,
    -- 'asset','liability','equity','revenue','expense'
    account_subtype varchar(30),
    -- 'current_asset','fixed_asset','current_liability','long_term_liability'
    -- 'operating_revenue','other_revenue','cogs','operating_expense'
    normal_balance  char(1)     NOT NULL CHECK (normal_balance IN ('D','C')),
    -- D=Debit, C=Credit
    level           smallint    NOT NULL DEFAULT 1,
    is_detail       boolean     NOT NULL DEFAULT true,  -- false = header/grup
    currency        char(3)     NOT NULL DEFAULT 'IDR',
    is_active       boolean     NOT NULL DEFAULT true,
    notes           text,
    created_at      timestamptz NOT NULL DEFAULT now(),
    updated_at      timestamptz NOT NULL DEFAULT now()
);
CREATE UNIQUE INDEX uq_account_code ON accounts(code);
CREATE INDEX idx_account_parent ON accounts(parent_id) WHERE parent_id IS NOT NULL;
CREATE INDEX idx_account_type   ON accounts(account_type);

-- ── Jurnal umum ──────────────────────────────────────────────────
CREATE TABLE journal_entries (
    id              uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    journal_no      varchar(30) NOT NULL,
    period_id       uuid        NOT NULL REFERENCES accounting_periods(id),
    entry_date      date        NOT NULL,
    entry_type      varchar(30) NOT NULL,
    -- 'manual','auto_billing','auto_payment','auto_dispensing'
    -- 'auto_admission','auto_discharge','auto_po','auto_asset_depreciation'
    source_type     varchar(50),  -- tabel sumber: 'invoices','payments','dispensings', dll
    source_id       uuid,         -- id record sumber
    description     text          NOT NULL,
    total_debit     numeric(18,2) NOT NULL DEFAULT 0,
    total_credit    numeric(18,2) NOT NULL DEFAULT 0,
    status          varchar(20)   NOT NULL DEFAULT 'draft',
    -- 'draft','posted','reversed'
    posted_by       uuid          REFERENCES users(id),
    posted_at       timestamptz,
    reversed_by     uuid          REFERENCES users(id),
    reversed_at     timestamptz,
    reversal_je_id  uuid          REFERENCES journal_entries(id),
    created_by      uuid          REFERENCES users(id),
    created_at      timestamptz   NOT NULL DEFAULT now(),
    CONSTRAINT chk_je_balance CHECK (
        status = 'draft' OR ABS(total_debit - total_credit) < 0.01
    )
);
CREATE UNIQUE INDEX uq_journal_no   ON journal_entries(journal_no);
CREATE INDEX idx_je_period          ON journal_entries(period_id);
CREATE INDEX idx_je_date            ON journal_entries(entry_date);
CREATE INDEX idx_je_source          ON journal_entries(source_type, source_id) WHERE source_id IS NOT NULL;
CREATE INDEX idx_je_status          ON journal_entries(status);

-- ── Baris jurnal (detail debit/kredit) ──────────────────────────
CREATE TABLE journal_lines (
    id              uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    journal_id      uuid        NOT NULL REFERENCES journal_entries(id) ON DELETE CASCADE,
    line_number     smallint    NOT NULL,
    account_id      uuid        NOT NULL REFERENCES accounts(id),
    debit           numeric(18,2) NOT NULL DEFAULT 0,
    credit          numeric(18,2) NOT NULL DEFAULT 0,
    description     varchar(300),
    cost_center_id  uuid,       -- FK ke cost_centers (set setelah dibuat)
    CONSTRAINT chk_line_sign CHECK (
        (debit > 0 AND credit = 0) OR (credit > 0 AND debit = 0)
    )
);
CREATE INDEX idx_jl_journal  ON journal_lines(journal_id);
CREATE INDEX idx_jl_account  ON journal_lines(account_id);

-- ── Cost center ──────────────────────────────────────────────────
CREATE TABLE cost_centers (
    id              uuid        PRIMARY KEY DEFAULT uuid_generate_v4(),
    code            varchar(20) NOT NULL,
    name            varchar(100) NOT NULL,
    parent_id       uuid        REFERENCES cost_centers(id),
    installation_id uuid        REFERENCES installations(id),
    is_active       boolean     NOT NULL DEFAULT true
);
CREATE UNIQUE INDEX uq_cost_center_code ON cost_centers(code);

ALTER TABLE journal_lines
    ADD CONSTRAINT fk_jl_cost_center
    FOREIGN KEY (cost_center_id) REFERENCES cost_centers(id);

-- ── Buku besar (ledger) — view materialized ──────────────────────
CREATE TABLE general_ledger (
    id              bigserial   PRIMARY KEY,
    account_id      uuid        NOT NULL REFERENCES accounts(id),
    period_id       uuid        NOT NULL REFERENCES accounting_periods(id),
    journal_line_id uuid        NOT NULL REFERENCES journal_lines(id),
    entry_date      date        NOT NULL,
    description     varchar(300),
    debit           numeric(18,2) NOT NULL DEFAULT 0,
    credit          numeric(18,2) NOT NULL DEFAULT 0,
    balance         numeric(18,2) NOT NULL DEFAULT 0,  -- running balance
    cost_center_id  uuid        REFERENCES cost_centers(id),
    created_at      timestamptz NOT NULL DEFAULT now()
);
