-- ── Antrian aktif hari ini ───────────────────────────────────────
CREATE VIEW v_today_queue AS
SELECT
    v.id            AS visit_id,
    v.visit_number,
    v.queue_number,
    v.visit_status,
    v.checkin_at,
    v.queue_called_at,
    p.medical_record_no,
    p.full_name     AS patient_name,
    p.date_of_birth,
    DATE_PART('year', AGE(p.date_of_birth))::smallint AS age,
    c.name          AS clinic_name,
    c.code          AS clinic_code,
    e.full_name     AS doctor_name,
    CONCAT(d.title_prefix, ' ', e.full_name, ', ', d.title_suffix) AS doctor_full,
    ps.name         AS scheme_name,
    v.referral_type,
    v.chief_complaint
FROM visits v
JOIN patients p        ON p.id = v.patient_id
JOIN clinics c         ON c.id = v.clinic_id
LEFT JOIN doctors d    ON d.id = v.doctor_id
LEFT JOIN employees e  ON e.id = d.employee_id
JOIN payment_schemes ps ON ps.id = v.payment_scheme_id
WHERE v.visit_date = CURRENT_DATE
  AND v.visit_status NOT IN ('cancelled')
ORDER BY c.code, v.queue_number;

-- ── Rawat inap aktif ─────────────────────────────────────────────
CREATE VIEW v_active_admissions AS
SELECT
    a.id            AS admission_id,
    a.admission_no,
    a.admission_date,
    a.actual_los_days,
    a.admission_status,
    p.medical_record_no,
    p.full_name     AS patient_name,
    p.date_of_birth,
    r.building,
    r.floor,
    b.bed_number,
    r.room_class,
    c_dept.name     AS department_name,
    e_dpjp.full_name AS dpjp_name,
    CONCAT(d.title_prefix,' ',e_dpjp.full_name,', ',d.title_suffix) AS dpjp_full,
    ps.name         AS scheme_name
FROM admissions a
JOIN visits v          ON v.id = a.visit_id
JOIN patients p        ON p.id = a.patient_id
JOIN beds b            ON b.id = a.bed_id
JOIN rooms r           ON r.id = b.room_id
JOIN clinics c_dept    ON c_dept.id = v.clinic_id
LEFT JOIN doctors d    ON d.id = a.dpjp_doctor_id
LEFT JOIN employees e_dpjp ON e_dpjp.id = d.employee_id
JOIN payment_schemes ps ON ps.id = v.payment_scheme_id
WHERE a.admission_status = 'active';

-- ── Stok obat hampir habis ───────────────────────────────────────
CREATE VIEW v_low_stock_drugs AS
SELECT
    w.name      AS warehouse_name,
    dr.code     AS drug_code,
    dr.generic_name,
    dr.brand_name,
    dr.drug_form,
    dr.strength,
    ds.quantity AS current_qty,
    ds.reorder_level,
    ds.unit,
    ds.expired_date,
    dc.name     AS drug_class
FROM drug_stocks ds
JOIN pharmacy_warehouses w ON w.id = ds.warehouse_id
JOIN drugs dr               ON dr.id = ds.drug_id
JOIN drug_classes dc        ON dc.id = dr.drug_class_id
WHERE ds.quantity <= ds.reorder_level
  AND ds.reorder_level > 0
  AND dr.is_active = true
ORDER BY w.name, (ds.quantity / NULLIF(ds.reorder_level,0));

-- ── Tagihan outstanding ──────────────────────────────────────────
CREATE VIEW v_outstanding_invoices AS
SELECT
    i.invoice_no,
    i.invoice_date,
    i.status,
    p.medical_record_no,
    p.full_name     AS patient_name,
    ps.name         AS scheme_name,
    py.name         AS payer_name,
    i.total_amount,
    i.covered_amount,
    i.patient_portion,
    i.paid_amount,
    i.outstanding_amount,
    i.due_date,
    CASE WHEN i.due_date < CURRENT_DATE
         THEN (CURRENT_DATE - i.due_date)
         ELSE 0 END AS overdue_days
FROM invoices i
JOIN visits v          ON v.id = i.visit_id
JOIN patients p        ON p.id = i.patient_id
JOIN payment_schemes ps ON ps.id = i.payment_scheme_id
LEFT JOIN payers py    ON py.id = ps.payer_id
WHERE i.outstanding_amount > 0
  AND i.status NOT IN ('cancelled')
ORDER BY i.due_date NULLS LAST;

-- ── Statistik kunjungan harian ───────────────────────────────────
CREATE VIEW v_daily_visit_stats AS
SELECT
    v.visit_date,
    v.visit_type,
    c.name          AS clinic_name,
    i_type.installation_type,
    COUNT(*)        AS total_visits,
    COUNT(*) FILTER (WHERE v.visit_status = 'done') AS completed,
    COUNT(*) FILTER (WHERE v.visit_status = 'cancelled') AS cancelled,
    COUNT(*) FILTER (WHERE ps.scheme_type = 'bpjs') AS bpjs_count,
    COUNT(*) FILTER (WHERE ps.scheme_type = 'general') AS general_count,
    COUNT(*) FILTER (WHERE ps.scheme_type = 'insurance') AS insurance_count,
    COUNT(*) FILTER (WHERE ps.scheme_type = 'corporate') AS corporate_count
FROM visits v
JOIN clinics c          ON c.id = v.clinic_id
JOIN departments dept   ON dept.id = c.department_id
JOIN installations i_type ON i_type.id = dept.installation_id
JOIN payment_schemes ps ON ps.id = v.payment_scheme_id
GROUP BY v.visit_date, v.visit_type, c.name, i_type.installation_type
ORDER BY v.visit_date DESC, total_visits DESC;

