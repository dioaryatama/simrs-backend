-- ── Views Keuangan ───────────────────────────────────────────────
CREATE VIEW v_trial_balance AS
SELECT
    a.code                          AS account_code,
    a.name                          AS account_name,
    a.account_type,
    a.normal_balance,
    ap.name                         AS period_name,
    COALESCE(SUM(gl.debit),  0)     AS total_debit,
    COALESCE(SUM(gl.credit), 0)     AS total_credit,
    COALESCE(SUM(gl.debit), 0)
        - COALESCE(SUM(gl.credit),0) AS net_balance
FROM accounts a
LEFT JOIN general_ledger gl ON gl.account_id = a.id
LEFT JOIN accounting_periods ap ON ap.id = gl.period_id
WHERE a.is_detail = true
GROUP BY a.id, a.code, a.name, a.account_type, a.normal_balance, ap.id, ap.name
ORDER BY a.code;

CREATE VIEW v_income_statement AS
SELECT
    a.account_type,
    a.account_subtype,
    a.code,
    a.name,
    COALESCE(SUM(CASE WHEN a.normal_balance='C' THEN gl.credit - gl.debit
                      ELSE gl.debit - gl.credit END), 0) AS amount
FROM accounts a
LEFT JOIN general_ledger gl ON gl.account_id = a.id
WHERE a.account_type IN ('revenue','expense')
  AND a.is_detail = true
GROUP BY a.id, a.account_type, a.account_subtype, a.code, a.name
ORDER BY a.code;

