    appointment_date  date        NOT NULL,
    time_slot         time        NOT NULL,
    payment_scheme_id uuid        REFERENCES payment_schemes(id),
    status            varchar(20) NOT NULL DEFAULT 'booked',
    -- 'booked','confirmed','checked_in','done','cancelled','no_show'
    visit_id          uuid        REFERENCES visits(id),  -- terisi saat check-in
    booking_channel   varchar(20) DEFAULT 'counter',      -- 'counter','online','phone'
    cancellation_reason text,
