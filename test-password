    expired_date      date,
    is_active         boolean     NOT NULL DEFAULT true,
    notes             text,
    created_at        timestamptz NOT NULL DEFAULT now(),
    updated_at        timestamptz NOT NULL DEFAULT now(),
    CONSTRAINT chk_doctor_fee_positive CHECK (amount >= 0),
    CONSTRAINT chk_doctor_fee_dates    CHECK (expired_date IS NULL OR expired_date > effective_date)
);
CREATE INDEX idx_doctor_fees_doctor   ON doctor_fees(doctor_id);
CREATE INDEX idx_doctor_fees_clinic   ON doctor_fees(clinic_id) WHERE clinic_id IS NOT NULL;
