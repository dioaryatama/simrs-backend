    weight_kg       numeric(5,2),
    height_cm       numeric(5,1),
    -- bmi tidak bisa GENERATED karena operator ^ pada float non-immutable di PG
    -- dihitung otomatis oleh trigger trg_vitals_bmi
    bmi             numeric(5,2),
    systolic_bp     smallint,
    diastolic_bp    smallint,
    pulse_rate      smallint,
    respiratory_rate smallint,
    temperature_c   numeric(4,1),
    spo2_pct        smallint,
